DATABASE_URL=postgresql://hamr:changeme@localhost:5432/hamr_app
PORT=3002
RUST_LOG=info

# P2P 节点身份与数据目录（可选）
HAMR_DATA_DIR=~/.hamr

# 认证模式：open | shared-secret | did
#   open (默认): 局域网信任，所有请求注入默认 Claims
#   shared-secret: 要求 Authorization: Bearer <HAMR_APP_SHARED_SECRET>
#   did: 验签 X-DID-Public-Key/X-DID-Timestamp/X-DID-Signature 头
HAMR_APP_AUTH_MODE=open
# shared-secret 模式必填
HAMR_APP_SHARED_SECRET=
# did 模式无需 secret，但每个调用方需要本地持有 Ed25519 密钥对（参见 did.rs）

# CORS allowlist（逗号分隔），未设置时使用本地默认
HAMR_APP_ALLOWED_ORIGINS=http://localhost:3010,http://localhost:3000

# ===== Agent 运行时（管家的大脑层）=====
# 默认关闭。未开启时 /api/v1/agent/* 统一返回 503。
HAMR_AGENT_ENABLED=false

# 模型来源：local（默认，本机模型，数据不出设备）| cloud（云端 API）
HAMR_AGENT_PROVIDER=local
# OpenAI 兼容端点。本地默认指向 Ollama；云端需显式指定。
HAMR_AGENT_BASE_URL=http://127.0.0.1:11434/v1
# 模型名
HAMR_AGENT_MODEL=qwen2.5:7b

# 云端专用：切 cloud 时必填，缺失则 Agent 降级为不可用
HAMR_AGENT_API_KEY=

# 是否允许把原始 PII（姓名/电话/邮箱/证件号）发给模型。
# 云端默认脱敏（成员姓名替换为「成员A/成员B」，联系方式屏蔽）；
# 本地 provider 下此项无意义 —— 数据根本没出设备。
HAMR_AGENT_ALLOW_PII=false

# 行为上限
HAMR_AGENT_MAX_STEPS=8
HAMR_AGENT_TIMEOUT_SECS=60
HAMR_AGENT_MAX_HISTORY=20

# 可选：JiaBu 决策引擎地址。配置后才向 Agent 暴露 jiabu_score 工具。
HAMR_JIABU_URL=
