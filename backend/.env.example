DATABASE_URL=postgresql://hamr:changeme@localhost:5432/hamr_app
PORT=3002
RUST_LOG=info

# P2P 节点身份与数据目录（可选）
HAMR_DATA_DIR=~/.hamr

# 认证模式：open | shared-secret | did
#   open (默认): 局域网信任，所有请求注入默认 Claims
#   shared-secret: 要求 Authorization: Bearer <HAMR_APP_SHARED_SECRET>
#   did: 验签 X-DID-Public-Key/X-DID-Timestamp/X-DID-Signature 头
HAMR_APP_AUTH_MODE=open
# shared-secret 模式必填
HAMR_APP_SHARED_SECRET=
# did 模式无需 secret，但每个调用方需要本地持有 Ed25519 密钥对（参见 did.rs）

# CORS allowlist（逗号分隔），未设置时使用本地默认
HAMR_APP_ALLOWED_ORIGINS=http://localhost:3010,http://localhost:3000
